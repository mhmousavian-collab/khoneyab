# Optional OpenAI-compatible endpoints. Leave empty for rule-based query parsing and core functionality without AI.
# Base URL example: http://host.docker.internal:8080/v1
# For a Linux host, add host.docker.internal mapping to the backend service if needed:
# extra_hosts:
#   - "host.docker.internal:host-gateway"
AI_CHEAP_BASE_URL=
AI_CHEAP_MODEL=
AI_CHEAP_API_KEY=

AI_STANDARD_BASE_URL=
AI_STANDARD_MODEL=
AI_STANDARD_API_KEY=

AI_PREMIUM_BASE_URL=
AI_PREMIUM_MODEL=
AI_PREMIUM_API_KEY=
