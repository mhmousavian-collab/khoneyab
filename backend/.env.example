# Optional OpenAI-compatible chat-completions configuration. Leave blank for full offline/rule-based mode.
# Use a base URL such as http://host.docker.internal:8080/v1 (not the full /chat/completions URL).
AI_CHEAP_BASE_URL=
AI_CHEAP_MODEL=
AI_CHEAP_API_KEY=

AI_STANDARD_BASE_URL=
AI_STANDARD_MODEL=
AI_STANDARD_API_KEY=

AI_PREMIUM_BASE_URL=
AI_PREMIUM_MODEL=
AI_PREMIUM_API_KEY=

# SQLite persists to ./data/khoneyab.db by default.
DATABASE_URL=sqlite:///./data/khoneyab.db
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://127.0.0.1:5173
